# Copy this file to .env and fill it in. Never commit .env.

# Postgres connection string (Neon: Dashboard → Connect; Supabase: Connect → Transaction pooler)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# The site's public address. Used to build links in emails. Must be set on Vercel.
APP_URL=http://localhost:5173

# Optional locally — without these, emails are printed in the terminal instead of sent.
RESEND_API_KEY=
MAIL_FROM=KAHAWA <hello@yourdomain.com>
